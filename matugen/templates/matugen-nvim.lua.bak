-- Auto-generated by Matugen (standalone; no external base16 plugin required)
-- This file is safe to dofile() directly and will set highlights using vim.api.nvim_set_hl

-- Colormap (filled by matugen)
local colors = {
	base00 = "{{colors.background.default.hex}}",
	base01 = "{{colors.surface_container_lowest.default.hex}}",
	base02 = "{{colors.surface_container_low.default.hex}}",
	base03 = "{{colors.outline_variant.default.hex}}",
	base04 = "{{colors.on_surface_variant.default.hex}}",
	base05 = "{{colors.on_surface.default.hex}}",
	base06 = "{{colors.inverse_on_surface.default.hex}}",
	base07 = "{{colors.surface_bright.default.hex}}",

	base08 = "{{colors.error.default.hex}}",
	base09 = "{{colors.tertiary.default.hex}}",
	base0A = "{{colors.secondary.default.hex}}",
	base0B = "{{colors.primary.default.hex}}",
	base0C = "{{colors.tertiary_container.default.hex}}",
	base0D = "{{colors.primary_container.default.hex}}",
	base0E = "{{colors.secondary_container.default.hex}}",
	base0F = "{{colors.error_container.default.hex}}",
}

-- Provide a name so Vim knows a colorscheme is active
vim.g.colors_name = "matugen_generated"

-- Helper: safely set highlight
local function set_hl(group, attrs)
	pcall(vim.api.nvim_set_hl, 0, group, attrs)
end

local function set_hl_multiple(groups, attrs)
	for _, g in ipairs(groups) do
		set_hl(g, attrs)
	end
end

-- Basic UI
set_hl("Normal", { bg = colors.base00, fg = colors.base05 })
set_hl("Visual", { bg = colors.base0D, fg = colors.base00 })
set_hl("CursorLine", { bg = colors.base01 })
set_hl("LineNr", { fg = colors.base03 })
set_hl("CursorLineNr", { fg = colors.base05, bold = true })
set_hl("StatusLine", { bg = colors.base01, fg = colors.base05 })
set_hl("StatusLineNC", { bg = colors.base00, fg = colors.base03 })
set_hl("Pmenu", { bg = colors.base01, fg = colors.base05 })
set_hl("FloatBorder", { bg = colors.base00, fg = colors.base04 })
set_hl("NormalFloat", { bg = colors.base00, fg = colors.base05 })

-- Message area
set_hl("MsgArea", { bg = colors.base01, fg = colors.base0B })

-- Syntax / Treesitter (common groups)
set_hl_multiple({ "Comment", "TSComment" }, { fg = colors.base03, italic = true })
set_hl_multiple({ "Constant", "Number", "Boolean" }, { fg = colors.base09 })
set_hl_multiple({ "Identifier", "TSVariable" }, { fg = colors.base08 })
set_hl_multiple({ "Function", "TSFunction" }, { fg = colors.base0B })
set_hl_multiple({ "Method", "TSMethod" }, { fg = colors.base09 })
set_hl("Keyword", { fg = colors.base0E })
set_hl("Statement", { fg = colors.base0E })
set_hl("Conditional", { fg = colors.base0E })
set_hl("Repeat", { fg = colors.base0E })
set_hl("Operator", { fg = colors.base0D })

-- LSP / Diagnostics
set_hl("DiagnosticError", { fg = colors.base08 })
set_hl("DiagnosticWarn", { fg = colors.base0A })
set_hl("DiagnosticInfo", { fg = colors.base0D })
set_hl("DiagnosticHint", { fg = colors.base0C })

-- Extra: set some UI plugin-ish groups commonly used by statuslines, trees, etc.
set_hl("TabLine", { bg = colors.base01, fg = colors.base04 })
set_hl("TabLineSel", { bg = colors.base02, fg = colors.base05, bold = true })

-- Any other tweaks you had in original template can be appended here
-- e.g., your previous specific tweaks:
set_hl("Visual", { bg = "{{colors.primary_container.default.hex}}", fg = "{{colors.background.default.hex}}" })
set_hl_multiple({ "TSComment", "Comment" }, { fg = "{{colors.on_tertiary_container.default.hex}}" })
set_hl_multiple({ "TSMethod", "Method" }, { fg = "{{colors.tertiary.default.hex}}" })
set_hl_multiple({ "TSFunction", "Function" }, { fg = "{{colors.secondary.default.hex}}" })
set_hl("Keyword", { fg = "{{colors.inverse_primary.default.hex}}" })
set_hl("MsgArea", { bg = "{{colors.surface_container_lowest.default.hex}}", fg = "{{colors.primary.default.hex}}" })

-- Optionally return the colors table (not required, but useful)
return colors
