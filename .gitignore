# ============================================================
# 策略：默认忽略顶层所有条目（/* 只匹配根目录下的一级条目），
# 然后白名单需要的目录。白名单一个目录后，其内部所有文件
# 默认都会被追踪，只需对"大文件/可再生成/敏感内容"单独排除。
# ============================================================

/*

# --- 顶层文件 ---
!/.gitignore
!/README.md
!/mimeapps.list
!/electron-flags.conf
!/qq-flags.conf
!/wechat-flags.conf

# --- 白名单目录（每行一个，无需再写 !dir/**）---
!/archived/
!/aria2/
!/caelestia/
!/cava/
!/fastfetch/
!/fish/
!/gtk-3.0/
!/gtk-4.0/
!/hypr/
!/kitty/
!/matugen/
!/nwg-look/
!/nvim/
!/pipewire/
!/qt5ct/
!/qt6ct/
!/quickshell/
!/rofi/
!/satty/
!/swayimg/
!/swaync/
!/waybar/
!/wlogout/
!/yazi/
!/.vim/

# --- 嵌套目录：先取消父目录，再收紧范围 ---
!/.local/
.local/*
!.local/share/
.local/share/*
!.local/share/applications/

# --- 壁纸备份
!/wallpapers/
!/wallpapers/**

# !/.cache/
# .cache/*
# !.cache/wal/

# ============================================================
# 各目录内的排除项
# ============================================================

# vim 插件由插件管理器还原，不入库
.vim/plugged/

# mpv：第三方脚本可重新获取，缓存/字体不入库
mpv/scripts/
mpv/cache/
mpv/fonts/

# rofi：主题图片体积大，按需入库（若主题依赖这些图请删掉此行）
rofi/images/

# 杂项垃圾文件
*.swp
__pycache__/
node_modules/

# 含 API Key 的本地文件，永不入库
fish/conf.d/ai-api.fish
