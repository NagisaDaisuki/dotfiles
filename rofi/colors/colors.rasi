/**
 *
 * Author : Aditya Shakya (adi1090x)
 * Github : @adi1090x
 * * Colors generated by Matugen (Modified for Transparency)
 **/

* {
    /* * 1. 定义核心颜色 (Matugen变量 + FF 不透明度) 
     */
    primary-bg:     @surface_dimFF;
    primary-fg:     @on_surfaceFF;
    
    /* 2. 定义 Rofi 元素颜色 */
    
    /* Rofi 默认背景（用于窗口模糊，需要透明度）
     * #CC 表示 80% 不透明度 (AA 位于 RRGGBB 之后)
     */
    background:     @surface_dimCC; 
    
    /* Rofi 次要背景（通常用于输入框/列表，我们使其完全透明） */
    background-alt: #00000000;
    
    /* Rofi 文本颜色 */
    foreground:     @on_surfaceFF;
    
    /* 选中项的颜色 */
    selected:       @primary_containerFF;
    
    /* 活动项和紧急项 */
    active:         @tertiaryFF;
    urgent:         @errorFF;
}
