/**
 * Matugen Rofi Colors (Transparent Version)
 **/

* {
    /* --- 关键修改 --- */
    /* 在颜色后面加上 CC 表示 80% 不透明度 (你可以改成 AA 或 99 让它更透) */
    background:     #1a1112CC;

    /* 列表项背景也稍微透一点，或者保持 FF (如果你希望交替行不透明) */
    background-alt: #261d1eCC;

    /* --- 以下保持 FF (不透明) 以确保文字清晰 --- */
    foreground:     #f0dedfFF;
    selected:       #ffb2bbFF;
    active:         #e5bdc0FF;
    urgent:         #ffb4abFF;
}
