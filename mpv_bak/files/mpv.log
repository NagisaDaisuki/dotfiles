ecked')"},{"title":"切换 字幕时序修复","state":[],"shortcut":"K","cmd":"cycle sub-fix-timing                 ;show-text \"字幕时序修复:${sub-fix-timing}\"                       #menu: 字幕 > 兼容性 > 切换 字幕时序修复        #@state=(sub_fix_timing and 'checked')"},{"title":"切换 字幕颜色转换方式","shortcut":"J","cmd":"cycle sub-ass-vsfilter-color-compat  ;show-text \"字幕颜色转换方式:${sub-ass-vsfilter-color-compat}\"    #menu: 字幕 > 兼容性 > 切换 字幕颜色转换方式"},{"title":"切换 使用视频信息","shortcut":"V","cmd":"cycle sub-ass-use-video-data ;show-text \"使用视频信息:${sub-ass-use-video-data}\"                       #menu: 字幕 > 兼容性 > 切换 使用视频信息"},{"title":"切换 bidi 双向检测兼容性","state":[],"shortcut":"ALT+B","cmd":"cycle sub-vsfilter-bidi-compat       ;show-text \"bidi 双向检测兼容性:${sub-vsfilter-bidi-compat}\"      #menu: 字幕 > 兼容性 > 切换 bidi 双向检测兼容性 #@state=(sub_vsfilter_bidi_compat and 'checked')"},{"title":"切换 ass 字幕阴影边框缩放","shortcut":"ALT+X","cmd":"cycle-values sub-ass-style-overrides \"ScaledBorderAndShadow=no\" \"ScaledBorderAndShadow=yes\";show-text \"强制替换 ass 样式:${sub-ass-style-overrides}\"   #menu: 字幕 > 兼容性 > 切换 ass 字幕阴影边框缩放"},{"title":"切换 ass 字幕输出到黑边","state":[],"shortcut":"H","cmd":"cycle sub-ass-force-margins          ;show-text \"ass 字幕输出黑边:${sub-ass-force-margins}\"            #menu: 字幕 > 兼容性 > 切换 ass 字幕输出到黑边  #@state=(sub_ass_force_margins and 'checked')"},{"title":"切换 srt 字幕输出到黑边","state":["checked"],"shortcut":"ALT+Z","cmd":"cycle sub-use-margins                ;show-text \"srt 字幕输出黑边:${sub-use-margins}\"                  #menu: 字幕 > 兼容性 > 切换 srt 字幕输出到黑边  #@state=(sub_use_margins and 'checked')"},{"title":"切换 pgs 字幕输出到黑边","state":[],"shortcut":"P","cmd":"cycle stretch-image-subs-to-screen   ;show-text \"pgs 字幕输出黑边:${stretch-image-subs-to-screen}\"     #menu: 字幕 > 兼容性 > 切换 pgs 字幕输出到黑边  #@state=(stretch_image_subs_to_screen and 'checked')"},{"title":"切换 pgs 字幕灰度转换","state":[],"shortcut":"p","cmd":"cycle sub-gray;show-text \"pgs 字幕灰度转换:${sub-gray}\"                                                #menu: 字幕 > 兼容性 > 切换 pgs 字幕灰度转换    #@