度转换    #@state=(sub_gray and 'checked')"}],"type":"submenu"},{"type":"separator"},{"title":"切换 字幕选择脚本","shortcut":"Y","cmd":"script-message sub-select toggle                                                                       #menu: 字幕 > 切换 字幕选择脚本"},{"title":"打开 字幕下载菜单","shortcut":"CTRL+d","cmd":"script-message-to sub_assrt sub-assrt                                                                  #menu: 字幕 > 打开 字幕下载菜单"},{"title":"打开 字幕同步菜单","shortcut":"CTRL+m","cmd":"script-message-to autosubsync autosubsync-menu                                                         #menu: 字幕 > 打开 字幕同步菜单"},{"title":"打开 字幕内容菜单","shortcut":"CTRL+M","cmd":"script-binding select/select-subtitle-line                                                             #menu: 字幕 > 打开 字幕内容菜单"},{"title":"导出当前内封字幕","shortcut":"ALT+m","cmd":"script-message-to sub_export export-selected-subtitles                                                 #menu: 字幕 > 导出当前内封字幕"},{"title":"生成 AI 字幕","shortcut":"ALT+f","cmd":"script-message-to sub_fastwhisper sub-fastwhisper                                                      #menu: 字幕 > 生成 AI 字幕"},{"title":"翻译当前 srt 字幕","cmd":"script-message-to sub_fastwhisper sub-translate                                                        #menu: 字幕 > 翻译当前 srt 字幕"},{"type":"separator"},{"title":"其他操作","submenu":[{"title":"字幕上移","shortcut":"r","cmd":"add sub-pos -1;show-text \"字幕上移:${sub-pos}\"                                                         #menu: 字幕 > 其他操作 > 字幕上移"},{"title":"字幕下移","shortcut":"t","cmd":"add sub-pos +1;show-text \"字幕下移:${sub-pos}\"                                                         #menu: 字幕 > 其他操作 > 字幕下移"},{"title":"次字幕上移","shortcut":"R","cmd":"add secondary-sub-pos -1;show-text \"次字幕上移:${secondary-sub-pos}\"                                   #menu: 字幕 > 其他操作 > 次字幕上移"},{"title":"次字幕下移","shortcut":"T","cmd":"add secondary-sub-pos +1;show-text \"次字幕下移:${secondary-sub-pos}\"                                   #menu: 字幕 > 其他操作 > 次字幕下移"},{"title":"