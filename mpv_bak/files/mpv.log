n -1;show-text \"饱和度:${saturation}\"                                                     #menu: 画面 > 调色 > 饱和度 -1"},{"title":"饱和度 +1","shortcut":"8","cmd":"add saturation  1;show-text \"饱和度:${saturation}\"                                                     #menu: 画面 > 调色 > 饱和度 +1"},{"title":"色相 -1","shortcut":"-","cmd":"add hue -1;show-text \"色相:${hue}\"                                                                     #menu: 画面 > 调色 > 色相 -1"},{"title":"色相 +1","shortcut":"=","cmd":"add hue  1;show-text \"色相:${hue}\"                                                                     #menu: 画面 > 调色 > 色相 +1"},{"title":"重置","shortcut":"CTRL+BS","cmd":"set contrast 0;set brightness 0;set gamma 0;set saturation 0;set hue 0;show-text \"重置调色\"            #menu: 画面 > 调色 > 重置"}],"type":"submenu"},{"title":"去色带","submenu":[{"title":"deband 开关","state":[],"shortcut":"D","cmd":"cycle deband;show-text \"去色带:${deband}\"                                                              #menu: 画面 > 去色带 > deband 开关\t  #@state=(deband and 'checked')"},{"title":"deband 强度 +1","shortcut":"ALT+z","cmd":"add   deband-iterations +1;show-text \"增加去色带强度:${deband-iterations}\"                             #menu: 画面 > 去色带 > deband 强度 +1"},{"title":"deband 强度 -1","shortcut":"ALT+x","cmd":"add   deband-iterations -1;show-text \"降低去色带强度:${deband-iterations}\"                             #menu: 画面 > 去色带 > deband 强度 -1"}],"type":"submenu"},{"title":"HDR 相关","submenu":[{"title":"切换 HDR 映射曲线","shortcut":"h","cmd":"cycle-values tone-mapping auto spline bt.2390 hable bt.2446a st2094-40 st2094-10;show-text \"HDR 映射曲线:${tone-mapping}\"   #menu: 画面 > HDR 相关 > 切换 HDR 映射曲线"},{"title":"切换 HDR 动态映射","state":["checked"],"shortcut":"ALT+h","cmd":"cycle-values hdr-compute-peak yes no;show-text \"HDR 动态映射:${hdr-compute-peak}\"                      #menu: 画面 > HDR 相关 > 切换 HDR 动态映射  #@state=(hdr_compute_peak and 'checked')"},{"title":"切换 HDR 直通模式","state":[],"shortcut":"CTRL+h","cmd":"cycle target-colorspace-hint;show