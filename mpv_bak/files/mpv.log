ride}\"                         #menu: 画面 > 切换 宽高比 > 2.35:1"},{"title":"循环切换","shortcut":"A","cmd":"cycle-values video-aspect-override 16:9 4:3 2.35:1 -1;show-text \"宽高比:${video-aspect-override}\"      #menu: 画面 > 切换 宽高比 > 循环切换"}],"type":"submenu"},{"title":"左旋转","shortcut":"CTRL+LEFT","cmd":"cycle-values video-rotate 0 270 180 90;show-text \"视频旋转:${video-rotate}\"                            #menu: 画面 > 左旋转"},{"title":"右旋转","shortcut":"CTRL+RIGHT","cmd":"cycle-values video-rotate 0 90 180 270;show-text \"视频旋转:${video-rotate}\"                            #menu: 画面 > 右旋转"},{"title":"画面缩放","submenu":[{"title":"缩小窗口","shortcut":"CTRL+-","cmd":"add window-scale -0.1;show-text \"窗口缩小:${window-scale}\"                                             #menu: 画面 > 画面缩放 > 缩小窗口"},{"title":"放大窗口","shortcut":"CTRL+=","cmd":"add window-scale  0.1;show-text \"窗口放大:${window-scale}\"                                             #menu: 画面 > 画面缩放 > 放大窗口"},{"title":"画面缩小","shortcut":"ALT+-","cmd":"add video-zoom   -0.1;show-text \"画面缩小:${video-zoom}\"                                               #menu: 画面 > 画面缩放 > 画面缩小"},{"title":"画面放大","shortcut":"ALT+=","cmd":"add video-zoom    0.1;show-text \"画面放大:${video-zoom}\"                                               #menu: 画面 > 画面缩放 > 画面放大"},{"title":"画面左移动","shortcut":"ALT+LEFT","cmd":"add video-pan-x  -0.1;show-text \"画面左移动:${video-pan-x}\"                                            #menu: 画面 > 画面缩放 > 画面左移动"},{"title":"画面右移动","shortcut":"ALT+RIGHT","cmd":"add video-pan-x   0.1;show-text \"画面右移动:${video-pan-x}\"                                            #menu: 画面 > 画面缩放 > 画面右移动"},{"title":"画面上移动","shortcut":"ALT+UP","cmd":"add video-pan-y  -0.1;show-text \"画面上移动:${video-pan-y}\"                                            #menu: 画面 > 画面缩放 > 画面上移动"},{"title":"画面下移动","shortcut":"ALT+DOWN","cmd":"add video-pan-y   0.1;show-text \"画面下移动:${video-pan-y}\"                                            #menu: 画面 > 画面缩放 > 画面下移动"}],"type":"submenu"},{"title":"开/关 裁切填充","state":["checked"],"shortcut":"ALT+p","cmd":"cycle-values panscan 0.0 1.0;show-text \"视频画面缩放:${panscan}\"                                       #menu: 画面 > 开/关 裁切填充        #@state=(panscan and 'checked')"},{"type":"separator"},{"title":"重置以上画面操作","shortcut":"ALT+BS","cmd":"set video-zoom 0;set panscan 0;set video-rotate 0;set video-pan-x 0;set video-pan-y 0;set video-aspect-override -1;show-text \"重置画面操作\"        #menu: 画面 > 重置以上画面操作"},{"type":"separator"},{"title":"开/关 自动 ICC 校色","state":[],"shortcut":"CTRL+I","cmd":"cycle icc-profile-auto   ;show-text \"ICC 自动校色:${icc-profile-auto}\"                                 #menu: 画面 > 开/关 自动 ICC 校色   #@state=(icc_profile_auto and 'checked')"},{"title":"开/关 非线性色彩转换","state":["checked"],"cmd":"cycle sigmoid-upscaling;show-text \"非线性色彩转换:${sigmoid-upscaling}\"                                #menu: 画面 > 开/关 非线性色彩转换  #@state=(sigmoid_upscaling and 'checked')"},{"title":"调色","submenu":[{"title":"对比度 -1","shortcut":"1","cmd":"add contrast -1;show-text \"对比度:${contrast}\"                                                         #menu: 画面 > 调色 > 对比度 -1"},{"title":"对比度 +1","shortcut":"2","cmd":"add contrast  1;show-text \"对比度:${contrast}\"                                                         #menu: 画面 > 调色 > 对比度 +1"},{"title":"明度 -1","shortcut":"3","cmd":"add brightness -1;show-text \"明度:${brightness}\"                                                       #menu: 画面 > 调色 > 明度 -1"},{"title":"明度 +1","shortcut":"4","cmd":"add brightness  1;show-text \"明度:${brightness}\"                                                       #menu: 画面 > 调色 > 明度 +1"},{"title":"伽马 -1","shortcut":"5","cmd":"add gamma -1;show-text \"伽马:${gamma}\"                                                                 #menu: 画面 > 调色 > 伽马 -1"},{"title":"伽马 +1","shortcut":"6","cmd":"add gamma  1;show-text \"伽马:${gamma}\"                                                                 #menu: 画面 > 调色 > 伽马 +1"},{"title":"饱和度 -1","shortcut":"7","cmd":"add 